# Secrets
.env
*.env

# Vault-Inhalte (SharePoint/OneDrive-Sync, nicht in Git)
_company/
_team-*/
_personal-*/

# Rohdokumente (grosse Binärdateien — nicht in Git)
raw/

# Wiki-Vault (generierter Inhalt — OneDrive-Sync reicht)
wiki/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.uv/
*.code-workspace

# Konfiguration mit internen Repo-Namen
code-repos.yaml
vault-tree.yaml

# Watch-State
.code-watch-state.json
*.lock

# Windows
Thumbs.db
desktop.ini

# Ingest-Logs (lokal, kein Versionierungsbedarf)
logs/

# Design-Templates (proprietär, nicht öffentlich)
templates/*.potx
templates/*.pptx

# Generierte Präsentationen (außer .gitkeep)
output/*
!output/.gitkeep

# Temporäre Dateien
*.tmp
~$*
