# ============================================================
# knowledge-tree — Konfiguration
# Kopiere diese Datei nach .env und fülle die Werte aus.
# .env ist in .gitignore und wird NIE eingecheckt.
# ============================================================

# Azure OpenAI (Pflicht)
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# GitHub PAT (für Code-Monitoring via code-watch.py)
# Scope: repo:read — https://github.com/settings/tokens/new?scopes=repo
GITHUB_PAT=<personal-access-token>

# Vault-Pfad: wo wiki/, raw/, assets/ liegen
# TRENNE Code (dieses Repo) von Daten (OneDrive/SharePoint)
# Beispiel Windows:  C:\Users\<user>\OneDrive - INFORM GmbH\knowledge-wiki
# Beispiel macOS:    /Users/<user>/Library/CloudStorage/OneDrive/knowledge-wiki
VAULT_ROOT=C:\Users\<user>\OneDrive - INFORM GmbH\knowledge-wiki

# Wiki-Archiv (für wiki-sync.py + GitHub Actions)
# PAT-Scope: repo — https://github.com/settings/tokens/new?scopes=repo
WIKI_ARCHIVE_PAT=<personal-access-token>
WIKI_ARCHIVE_REPO=schlinge2000/knowledge-wiki-archive

# SharePoint (für zentralen Ingest-Service — optional, Phase 3)
# SHAREPOINT_TENANT_ID=<tenant-id>
# SHAREPOINT_CLIENT_ID=<app-registration-client-id>
# SHAREPOINT_CLIENT_SECRET=<secret>
# SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
